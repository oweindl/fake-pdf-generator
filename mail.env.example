# Vorlage: kopieren nach mail.env und ausfüllen. mail.env wird nicht ins Repo aufgenommen (steht in .gitignore).
# Fester Empfänger aller Mails:
MAIL_TO=empfaenger@example.de

# Echter Versand über den eigenen Mailserver (nur für --transport smtp nötig):
SMTP_HOST=smtp.example.de
SMTP_PORT=587
SMTP_USER=benutzer@example.de
SMTP_PASS=geheim
SMTP_FROM=rechnung@example.de

# true bei implizitem TLS (Port 465); bei Port 587/25 auf false lassen (STARTTLS wird automatisch benutzt)
SMTP_SSL=false
